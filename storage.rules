rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /campushub/files/{filename} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null
                    && resource.metadata['uploadedBy'] == request.auth.uid;
    }

    match /campushub/profiles/{filename} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /campushub/chat/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /campushub/groups/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /campushub/channels/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /campushub/posts/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /campushub/announcements/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /campushub/audio/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
